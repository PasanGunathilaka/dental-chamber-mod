<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DentalManagement.DataMigration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DentalManagement.Infrastructure\DentalManagement.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Legacy reads go through raw ADO.NET, never a reconstructed EF6 model
      (design D-5): resurrecting the legacy model would import the broken
      migration chain this whole item exists to avoid.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
