<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <!--
    DentalDbContext and ApplicationDbContext (DM.AuthServer.Models.ApplicationDbContext) are BOTH
    constructed with "name=DefaultConnection" / "DefaultConnection" — see DM.Models/DentalDbContext.cs
    and DM.Server/Models/ApplicationDbContext.cs, both read directly this run — so a single connection
    string here drives every fixture's Arrange step, exactly as it drives the real legacy app's own two
    contexts sharing one physical database (CQ-002's own finding).

    This points at a dedicated LocalDB database, never at the legacy app's own "MahmudaDentalDb" — the
    harness must never run against real clinic data. Override via a machine-specific App.config
    transform or an environment-specific connection string if LocalDB is unavailable; see README.md.
  -->
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DM_Baseline_Harness;Integrated Security=true" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!--
      anchor_date: the calendar date every scenario's relative dates are computed from
      (CONTRACT.md (a)) — overridable so a captured fixture set can be reproduced from a fixed
      anchor rather than "whatever day `record` happened to run on." Defaults to this generation
      run's own date; a human capturing fixtures later may override it, e.g. via an environment
      variable read at test start, without editing this file.
    -->
    <add key="AnchorDate" value="2026-08-12" />

    <!--
      Repo-relative fixtures output directory, resolved against RepoPaths.RepoRoot (Infrastructure\RepoPaths.cs).
      Matches harness-manifest.json's own fixtures_output_dir.
    -->
    <add key="FixturesOutputDir" value=".specclaw/baseline/fixtures" />
  </appSettings>

  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        EntityFramework.SqlServer's own binding redirects, mirrored from DM.Server/Web.config, since
        this project references the same EntityFramework 6.4.4 package and needs the same redirects to
        load without a runtime bind failure.
      -->
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <!--
          13.0.0.0 is the ASSEMBLY version; 13.0.2 is the NuGet PACKAGE version. They differ, and
          the redirect must name the assembly version or every load fails with FileLoadException
          ("manifest definition does not match the assembly reference"). Matches the legacy app's
          own DM.Server/Web.config:75, which already redirects to 13.0.0.0.
        -->
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.1.0" newVersion="3.0.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
